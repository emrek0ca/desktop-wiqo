{
  "version": 1,
  "about": "One classification for every failure code the Mac and Windows companions, the browser and document workers and the backend report. The backend reads it (generated into src/tools/deviceErrorCodes.generated.ts) to decide, from the code rather than from the wording, whether to observe again, retry once or stop, and whether the step may have changed anything. contracts/companion/error-codes.mjs fails when a companion reports a code that is not listed here.",
  "fields": {
    "recovery": "observe = look at the screen or page again first; retry_once = a transient error, one more try is safe; stop = no automatic repeat; null = the model may choose another route or ask.",
    "effect": "none = nothing was changed; partial = the action failed but may have changed something; uncertain = the result is unknown, never repeat the same action.",
    "blocked": "true = needs the person or a permission, or a safety rule refused it: do not retry and do not try a side route."
  },
